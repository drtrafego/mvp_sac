# Comum Meta (WhatsApp + Instagram)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Instagram Messaging API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_PAGE_ID=

# Entrada de e-mail por webhook ou IMAP
EMAIL_PROVIDER=smtp
EMAIL_ACCOUNT_ID=
EMAIL_WEBHOOK_SECRET=
EMAIL_SIGNATURE_HEADER=X-Email-Signature
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_MAILBOX=INBOX
EMAIL_IMAP_SSL=true
EMAIL_IMAP_STARTTLS=false

# Saída SMTP genérica
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SENDER=
EMAIL_SENDER_NAME=Hermes
SMTP_STARTTLS=true
SMTP_SSL=false

# Alternativa de saída Brevo (EMAIL_PROVIDER=brevo)
BREVO_API_KEY=

# Aplicação
PUBLIC_WEBHOOK_BASE_URL=https://exemplo.invalid/webhooks
TENANT_ID=
DEDUPE_TTL_DAYS=30
