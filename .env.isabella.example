# Isabella Franklin: somente nomes de variáveis, sem segredos.
TENANT_ID=bella-franklin-desenvolvimento-sistemicos
CRM_SCHEMA=bella_franklin
DATABASE_PATH=var/isabella-multicanal.sqlite3
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
WORKER_POLL_SECONDS=1
# true impede qualquer chamada externa mesmo se uma chave for preenchida.
DRY_RUN=true
# Em producao use true: impede iniciar se alguma integracao obrigatoria faltar.
STRICT_CONFIG=false

HERMES_BASE_URL=http://127.0.0.1:8000
HERMES_API_KEY=
HERMES_MODEL=Hermes
META_GRAPH_API_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

INSTAGRAM_ACCOUNT_ID=17841400715053626
INSTAGRAM_PAGE_ID=239367175926974
INSTAGRAM_ACCESS_TOKEN=

WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Provedor ainda nao definido: o dominio nao publica MX em 08/09/2026.
# Opcoes de entrada: webhook canonico ou IMAP. Saida: API do provedor ou SMTP.
EMAIL_PROVIDER=
EMAIL_ACCOUNT_ID=
EMAIL_WEBHOOK_SECRET=
EMAIL_SIGNATURE_HEADER=X-Email-Signature
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_MAILBOX=INBOX
EMAIL_IMAP_SSL=true
EMAIL_IMAP_STARTTLS=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
SMTP_SSL=false
SMTP_STARTTLS=true
EMAIL_SENDER_NAME=Bella Franklin
# Somente usado se EMAIL_PROVIDER=brevo; SMTP usa as variaveis acima.
BREVO_API_KEY=
EMAIL_SENDER=

PUBLIC_WEBHOOK_BASE_URL=
DEDUPE_TTL_DAYS=30
