# Somente configuração pública. Use autenticação PostgreSQL por certificado,
# socket/identidade da plataforma ou injete DATABASE_URL por um secret manager.
DATABASE_URL=postgresql://sac_runtime@postgres.internal:5432/sac?sslmode=verify-full
SECRET_DIR=/run/secrets/sac
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
WORKER_POLL_SECONDS=1

# Caminho no host; os arquivos internos precisam ser regulares e chmod 600.
SAC_SECRET_HOST_DIR=/srv/hermes-sac/secrets

# Painel do operador (leitura real e escrita auditada em /sac/).
# Sem PANEL_OPERATORS_REF o painel responde 503: ele nunca abre por omissão.
# A referência aponta para um arquivo dentro de SECRET_DIR, regular e chmod 600,
# contendo apenas hashes de senha (use scripts/painel-operador.py para gerá-los).
PANEL_OPERATORS_REF=painel/operadores.json
# Em produção o cookie de sessão precisa continuar Secure (padrão). Só a
# homologação em loopback muda isso.
PANEL_COOKIE_SECURE=true
# Prefixo por onde o navegador enxerga o painel; define o Path do cookie.
PANEL_COOKIE_PATH=/sac/
PANEL_SESSION_TTL_SECONDS=28800
PANEL_SESSION_IDLE_SECONDS=1800
# Analytics do painel. O fuso vale para a agregação diária: em UTC o gráfico do
# cliente sai deslocado. O cache é por (agente, relatório, janela) e vive só na
# memória do processo. O teto de dias limita o que o cliente consegue pedir.
PANEL_ANALYTICS_TZ=America/Sao_Paulo
PANEL_ANALYTICS_CACHE_SECONDS=60
PANEL_ANALYTICS_MAX_DAYS=366
