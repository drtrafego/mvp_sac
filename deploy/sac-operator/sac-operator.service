[Unit]
Description=Executor do Operador SAC (fila, Codex headless)
After=network-online.target

[Service]
User=claude
WorkingDirectory=/opt/gastaomatos/sac-operator
ExecStart=/usr/bin/node /opt/gastaomatos/sac-operator/app/scripts/sac-operator/worker.ts
EnvironmentFile=/opt/gastaomatos/acessos/renato/env.sac-operator
Environment=SAC_OPERATOR_URL=https://sac.casaldotrafego.com OPERATOR_EXECUTOR_MODEL=gpt-5.6-luna OPERATOR_EXECUTOR_CODEX_HOME=/opt/gastaomatos/sac-operator/codex-home
Restart=always
RestartSec=5
ProtectHome=yes
ProtectSystem=strict
TemporaryFileSystem=/opt/gastaomatos:ro
BindReadOnlyPaths=/opt/gastaomatos/sac-operator/app
BindPaths=/opt/gastaomatos/sac-operator/run /opt/gastaomatos/sac-operator/codex-home
PrivateTmp=yes
MemoryMax=1500M
CPUQuota=150%
TasksMax=128
Nice=10
SyslogIdentifier=sac-operator

[Install]
WantedBy=multi-user.target
